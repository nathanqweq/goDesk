#!/bin/sh
set -e

case "$1" in
  configure)
    mkdir -p /var/log/godesk
    chown zabbix:zabbix /var/log/godesk 2>/dev/null || true

    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload || true
      systemctl enable --now godesk.service || true
    fi
    ;;
esac

exit 0
