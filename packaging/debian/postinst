#!/bin/sh
set -e

case "$1" in
  configure)
    mkdir -p /var/log/godesk
    chown zabbix:zabbix /var/log/godesk 2>/dev/null || true

    # estado persistente (godesk-metrics.json, lido por "godesk --monitoring")
    mkdir -p /var/lib/godesk
    chown zabbix:zabbix /var/lib/godesk 2>/dev/null || true
    chmod 755 /var/lib/godesk

    # o servico roda como "zabbix" (User=zabbix na unit) e precisa gravar
    # godesk-config.yaml + backup nessa pasta (endpoint POST /config)
    mkdir -p /etc/zabbix/godesk
    chmod 777 /etc/zabbix/godesk

    if command -v systemctl >/dev/null 2>&1; then
      systemctl daemon-reload || true
      systemctl enable godesk.service || true
      # restart (nao so "enable --now"): garante que upgrades apliquem o
      # binario/unit novos mesmo se o servico ja estava rodando
      systemctl restart godesk.service || true
    fi
    ;;
esac

exit 0
