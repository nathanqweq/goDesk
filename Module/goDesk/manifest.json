{
  "manifest_version": 2.0,
  "id": "godesk",
  "name": "goDesk",
  "version": "1.5.0",
  "namespace": "GoDesk",
  "description": "goDesk module (config viewer/editor).",
  "assets": {
    "css": ["godesk.css"],
    "js": ["godesk.js", "godesk-topology.js", "godesk-flows.js"]
  },
  "actions": {
    "godesk.config.view": {
      "class": "ConfigView",
      "view": "godesk.configview"
    },
    "godesk.config.edit": {
      "class": "ConfigEdit",
      "view": "godesk.configedit"
    },
    "godesk.config.validate": {
      "class": "ConfigValidate",
      "view": "godesk.configvalidate",
      "layout": "layout.json"
    },
    "godesk.dependencies.edit": {
      "class": "DependenciesEdit",
      "view": "godesk.dependencies"
    },
    "godesk.dependencies.triggers": {
      "class": "DependenciesTriggers",
      "view": "godesk.dependencies.triggers",
      "layout": "layout.json"
    },
    "godesk.topology.edit": {
      "class": "DependenciesV2Edit",
      "view": "godesk.topology"
    },
    "godesk.topology.view": {
      "class": "TopologyView",
      "view": "godesk.topology.view"
    },
    "godesk.flows.edit": {
      "class": "FlowsEdit",
      "view": "godesk.flows"
    },
    "godesk.flows.view": {
      "class": "FlowsView",
      "view": "godesk.flows.view"
    },
    "godesk.flows.history": {
      "class": "FlowsHistory",
      "view": "godesk.flows.history"
    },
    "godesk.flows.data": {
      "class": "FlowsData",
      "view": "godesk.flows.data",
      "layout": "layout.json"
    },
    "godesk.topology.data": {
      "class": "DependenciesV2Data",
      "view": "godesk.topology.data",
      "layout": "layout.json"
    }
  }
}
