# Configuracao do godesk-client
# Caminho esperado em producao:
# /etc/zabbix/godesk/godesk-client.env
#
# Preencha com o endereco do host que roda "godesk serve" e o mesmo
# GODESK_SERVICE_TOKEN configurado la (dist/godesk-service.env).

GODESK_SERVER_URL=http://SEU-SERVIDOR-GODESK:8787
GODESK_SERVICE_TOKEN=troque-por-um-token-secreto
