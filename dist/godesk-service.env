# Configuracao do servico goDesk (systemd)
# Caminho esperado em producao:
# /etc/zabbix/godesk/godesk-service.env

GODESK_LISTEN_ADDR=127.0.0.1:8787
GODESK_SERVICE_TOKEN=troque-por-um-token-secreto
TOPDESK_LOG_FILE=/var/log/godesk/godesk-service.log

# Arquivo de metricas persistentes (lido por "godesk --monitoring").
# Descomente so se quiser mudar do default abaixo.
#GODESK_METRICS_FILE=/var/lib/godesk/godesk-metrics.json

# TopDesk padrao do servico. Usado (1) pelo healthcheck periodico abaixo,
# que precisa de credenciais fixas (nao vem alerta nenhum pra tirar delas),
# e (2) como fallback quando o alerta do Zabbix nao manda DOMAIN/USER/PASS
# (se mandar, o valor do alerta tem prioridade sobre este aqui).
GODESK_TOPDESK_DOMAIN=https://SEU-TOPDESK.topdesk.net
GODESK_TOPDESK_USER=usuario_topdesk
GODESK_TOPDESK_PASS=senha_ou_api_key_topdesk

# Intervalo do healthcheck do TopDesk (GET /tas/api/incidents?pageSize=1).
# Aceita "30s", "5m", "1h" etc. Vazio ou ausente = desligado.
GODESK_HEALTHCHECK_INTERVAL=5m

# Zabbix padrao do servico (URL da API JSON-RPC + token de autenticacao,
# usado pro "event.acknowledge"). Mesma regra do TopDesk: se o alerta
# mandar ZABBIX_URL/ZABBIX_KEY preenchidos, eles tem prioridade; se vier
# vazio, usa o valor daqui.
GODESK_ZABBIX_URL=https://seu-zabbix.exemplo.com
GODESK_ZABBIX_KEY=token_api_do_zabbix
