# Configuracao do servico goDesk (systemd)
# Caminho esperado em producao:
# /etc/zabbix/godesk/godesk-service.env

GODESK_LISTEN_ADDR=127.0.0.1:8787
GODESK_SERVICE_TOKEN=troque-por-um-token-secreto
TOPDESK_LOG_FILE=/var/log/godesk/godesk-service.log

# Arquivo de metricas persistentes (lido por "godesk --monitoring").
# Descomente so se quiser mudar do default abaixo.
#GODESK_METRICS_FILE=/var/lib/godesk/godesk-metrics.json
